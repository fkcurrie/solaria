[Unit]
Description=Solaria Edge Telemetry Spooler & Cloud Sync Agent
Documentation=https://fkcurrie.github.io/solaria/
After=network.target solaria-bridge.service
Wants=solaria-bridge.service

[Service]
Type=simple
User=solaria
Group=solaria
WorkingDirectory=/opt/solaria
ExecStart=/usr/local/bin/solaria-edge
Restart=always
RestartSec=10s
EnvironmentFile=-/etc/solaria/solaria.env

# Security Sandbox
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
