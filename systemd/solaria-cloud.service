[Unit]
Description=Solaria Cloud Analytics & Dashboard Web Service
Documentation=https://fkcurrie.github.io/solaria/
After=network.target

[Service]
Type=simple
User=solaria
Group=solaria
WorkingDirectory=/opt/solaria
ExecStart=/usr/local/bin/solaria-cloud
Restart=always
RestartSec=5s
EnvironmentFile=-/etc/solaria/solaria.env

# Security Sandbox
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
