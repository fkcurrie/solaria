# Solaria Production Configuration Template

# ------------------------------------------------------------------------------
# Site Location Parameters (Dynamic Resolver Hierarchy)
# Solaria automatically detects coordinates via gpsd (localhost:2947) or IP Geo.
# Override default location explicitly by setting SITE_LATITUDE and SITE_LONGITUDE.
# ------------------------------------------------------------------------------
SITE_NAME="Off-Grid Solar Site"
SITE_LATITUDE=""
SITE_LONGITUDE=""

# ------------------------------------------------------------------------------
# Solar Hardware Specifications
# ------------------------------------------------------------------------------
SOLAR_ARRAY_PEAK_WATTS=400
BATTERY_CAPACITY_AH=100
BATTERY_NOMINAL_VOLTAGE=12

# ------------------------------------------------------------------------------
# Service Networking & Port Bindings
# ------------------------------------------------------------------------------
BRIDGE_HTTP_PORT=8080
CLOUD_HTTP_PORT=8081
SRE_HTTP_PORT=8082

# ------------------------------------------------------------------------------
# Cloud Ingestion & Authentication
# ------------------------------------------------------------------------------
CLOUD_SERVER_URL="http://localhost:8081"
SOLARIA_INGEST_KEY="solaria-default-secret-key"
BIGQUERY_PROJECT_ID=""
BIGQUERY_DATASET_ID="solaria_telemetry"
