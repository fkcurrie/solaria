[Unit]
Description=Solaria Autonomous SRE Supervisor & Self-Healing Watchdog
Documentation=https://github.com/fkcurrie/solaria
After=network-online.target solaria-bridge.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/fcurrie/Projects/solar-testing
EnvironmentFile=-/home/fcurrie/Projects/solar-testing/.env
ExecStart=/home/fcurrie/Projects/solar-testing/bin/solaria-sre-agent -supervisor
Restart=always
RestartSec=5s
TimeoutStopSec=10s

LimitNOFILE=65536
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_ADMIN

StandardOutput=journal
StandardError=journal
SyslogIdentifier=solaria-sre

[Install]
WantedBy=multi-user.target
